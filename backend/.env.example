# ---- Application ----
APP_NAME=ApplyLine
ENVIRONMENT=development          # development | production
DEBUG=true
API_V1_PREFIX=/api

# ---- Security (CHANGE THESE IN PRODUCTION) ----
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false              # true in production (HTTPS)
COOKIE_SAMESITE=lax              # lax | strict | none
COOKIE_DOMAIN=                   # optional, e.g. .yourdomain.com

# ---- Database ----
# Production: Neon PostgreSQL connection string. Dev default: local postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/applyline
# Used by Alembic if unset it falls back to DATABASE_URL

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Object storage (S3-compatible) ----
# provider: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=applyline-documents
STORAGE_ENDPOINT_URL=            # optional custom S3 endpoint
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_SIGNED_URL_EXPIRE_SECONDS=300

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=10
