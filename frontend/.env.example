# Public configuration only. Never put secrets here (VITE_ vars are exposed to the browser).

# In production, set this to the deployed backend API URL, e.g. https://applyline-api.onrender.com/api
# The client also accepts the bare host and appends /api automatically.
# Leave empty in local development to use the Vite proxy (/api -> http://localhost:8000).
VITE_API_URL=

# Local dev proxy target (optional)
VITE_API_PROXY=http://localhost:8000
